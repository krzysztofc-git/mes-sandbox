  {
    "id": "12",
    "type": "function",
    "z": "11",
    "name": "prepare command",
    "func": "msg.payload = `\nDECLARE @ResultOut VARCHAR(20);\nDECLARE @ProductNameOut VARCHAR(100);\nDECLARE @ReturnStatus INT;\n\nEXEC @ReturnStatus = ScanSerial\n    @SerialCode = '${msg.payload.serial}',\n    @UserID = ${msg.payload.userId}, \n    @StationID = ${msg.payload.stationId},\n    @Result = @ResultOut OUTPUT,\n    @ProductName = @ProductNameOut OUTPUT;\n\nSELECT\n    @ResultOut AS result,\n    @ProductNameOut AS productName,\n    @ReturnStatus as response;\n`;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 230,
    "y": 80,
    "wires": [
