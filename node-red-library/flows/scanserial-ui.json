  {
    "id": "28",
    "type": "function",
    "z": "25",
    "name": "prepare result",
    "func": "if (msg.payload.result.result === \"OK\") {\n    msg.payload.result = {\n        ...msg.payload.result,\n        type: \"success\",\n        message_dict_key: \"scan serial result ok\"\n    }\n} else if (msg.payload.result.result === \"SCRAPPED\") {\n    msg.payload.result = {\n        ...msg.payload.result,\n        type: \"warning\",\n        message_dict_key: \"scan serial result scrapped\"\n    }\n} else if (msg.payload.result.result === \"NOT FOUND\") {\n    msg.payload.result = {\n        ...msg.payload.result,\n        type: \"error\",\n        message_dict_key: \"scan serial result not found\"\n    }\n} else if (msg.payload.result.result === \"WRONG STATION\") {\n    msg.payload.result = {\n        ...msg.payload.result,\n        type: \"warning\",\n        message_dict_key: \"scan serial result wrong station\"\n    }\n} else if (msg.payload.result.result === \"MOVED\") {\n    msg.payload.result = {\n        ...msg.payload.result,\n        type: \"success\",\n        message_dict_key: \"scan serial result moved\"\n    }\n} else {\n    msg.payload.result = {\n        ...msg.payload.result,\n        type: \"error\",\n        message_dict_key: \"scan serial result unknown error\"\n    }\n}\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 820,
    "y": 80,
    "wires": [
