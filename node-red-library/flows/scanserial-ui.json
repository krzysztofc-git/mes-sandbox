  {
    "id": "10",
    "type": "MSSQL",
    "z": "7",
    "mssqlCN": "mssqlcn0",
    "name": "",
    "outField": "payload.latestScans",
    "returnType": 0,
    "throwErrors": "0",
    "query": "WITH RankedScans AS (\r\n    SELECT\r\n        SL.LogID,\r\n        S.SerialCode,\r\n        SL.ScanTime,\r\n        SL.Result,\r\n        U.Username,\r\n        CurrentStation.StationName AS CurrentStation,\r\n        PreviousStation.StationName AS PreviousStation,\r\n        ROW_NUMBER() OVER (\r\n            PARTITION BY S.SerialCode\r\n            ORDER BY SL.LogID DESC\r\n        ) AS RowNum\r\n    FROM ScanLog AS SL\r\n    LEFT JOIN Serials AS S\r\n        ON S.SerialID = SL.SerialID\r\n    LEFT JOIN Users AS U\r\n        ON U.UserID = SL.UserID\r\n    LEFT JOIN Stations AS CurrentStation\r\n        ON CurrentStation.StationID = S.CurrentStationID\r\n    LEFT JOIN SerialStationHistory AS H\r\n        ON H.HistoryID = (\r\n            SELECT TOP (1) H2.HistoryID\r\n            FROM SerialStationHistory AS H2\r\n            WHERE H2.SerialID = SL.SerialID\r\n            ORDER BY\r\n                H2.MoveTime DESC,\r\n                H2.HistoryID DESC\r\n        )\r\n    LEFT JOIN Stations AS PreviousStation\r\n        ON PreviousStation.StationID = H.FromStationID\r\n    WHERE SL.ScanTime >= DATEADD(MINUTE, -10, GETDATE())\r\n)\r\nSELECT\r\n    LogID,\r\n    SerialCode,\r\n    ScanTime,\r\n    Result,\r\n    Username,\r\n    CurrentStation,\r\n    PreviousStation\r\nFROM RankedScans\r\nWHERE RowNum = 1\r\nORDER BY LogID DESC",
    "modeOpt": "queryMode",
    "modeOptType": "query",
    "queryOpt": "payload",
    "queryOptType": "editor",
    "paramsOpt": "queryParams",
    "paramsOptType": "none",
    "rows": "rows",
    "rowsType": "msg",
    "parseMustache": true,
    "params": [],
    "x": 420,
    "y": 140,
    "wires": [
      [
        "9"
      ]
    ]
  },
