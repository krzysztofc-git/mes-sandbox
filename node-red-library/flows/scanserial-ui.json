    "name": "prepare msg.payload",
    "func": "msg.payload = {\n    ...(typeof msg.payload === 'string' ? {} : msg.payload),\n    query: msg.payload,\n    response: msg.response[0].response,\n    result: {...msg.response[0]}\n}\ndelete msg.payload.result.response;\nreturn msg;",
