  {
    "id": "22",
    "type": "function",
    "z": "1",
    "name": "function 1",
    "func": "msg.payload = [];\nif (typeof msg.error == \"undefined\") {\n    msg.payload.push(\"OK.\");\n} else {\n    msg.error.code = [...new Set(msg.error.code)];\n    if (msg.error.code.includes(\"EREQUEST\")) {\n        msg.payload.push(\"Already in DB.\");\n    }\n    if (msg.error.code.includes(\"ECONNCLOSED\")) {\n        msg.payload.push(\"Try again.\");\n    }\n}\n\n\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
